# Pick a provider on the Settings page (or `jobhunt settings set --provider ...`).
# Keys can be saved there too; environment variables here are the alternative.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Optional overrides
# JOBHUNT_PROVIDER=anthropic        # anthropic | openai | gemini | groq | openrouter
# JOBHUNT_MODEL=claude-opus-5
# JOBHUNT_HOME=./data
